services:
  beacon-node:
    image: {{.GetValue serviceContainerTag}}_bn
    container_name: {{.ModuleComposeProject}}_beacon-node # Container names are provided by Hyperdrive to handle conflicts
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{.GetValue "service/port"}}:{{.GetValue "service/port"}}/tcp" # Restricted to localhost outside of Docker
    volumes:
      - {{.ModuleConfigDir}}:{{.ModuleConfigDir}}:ro # The module's config directory
      - {{.ModuleLogDir}}:{{.ModuleLogDir}} # The module's log directory
      - {{.ModuleDataDir}}:/ethclient

        # TODO: Ask Joe about these
      # - /usr/share/hyperdrive/scripts:/usr/share/hyperdrive/scripts:ro
      # - /var/lib/hyperdrive/data/{{.Hyperdrive.ProjectName}}:/secrets:ro
    command:
      - "--config-file"
      - "{{.ModuleConfigDir}}/service-cfg.yaml" # The module's config directory
      - "--log-dir"
      - "{{.ModuleLogDir}}" # The module's log directory
      - --ip
      - "0.0.0.0" # Open to all Docker traffic
      - --port
      - "{{.GetValue "service/port"}}" # The port the module's server will listen on
    networks:
      - {{.ModuleNetwork}}
    cap_drop:
      - all # The container will run as root but this will drop all capabilities it doesn't need
    cap_add:
      - dac_override # Needed to access files owned by the user instead of root
    security_opt:
      - no-new-privileges
networks:
  {{.ModuleNetwork}}:
    external: true
